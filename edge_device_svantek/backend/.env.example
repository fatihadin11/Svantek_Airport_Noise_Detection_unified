# 32 byte AES anahtarının base64 karşılığı.
# Üretmek için proje kökünde:
#   backend\venv\Scripts\python.exe backend\tools\generate_aes_key.py
#
# Aynı değer Windows backend ve Raspberry Pi edge agent tarafından kullanılmalıdır.
# Gerçek anahtarı bu örnek dosyaya veya Git'e yazmayın.
AES_KEY_B64=CHANGE_ME_GENERATE_32_BYTE_KEY
